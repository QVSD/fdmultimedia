# FDM Multimedia v0.1.0-rc1 - production pilot configuration (placeholders only).
#
#   cp .env.pilot.example .env.pilot     (or run scripts/pilot-init.ps1 / scripts/pilot-init.sh, which also generates the secrets)
#   docker compose --env-file .env.pilot -f docker-compose.pilot.yml up -d --build
#
# Every value marked REQUIRED must be set; the stack refuses to start without it and the API refuses to start with a development
# placeholder. Never commit .env.pilot or the secrets/ directory. Full reference: docs/CONFIGURATION.md

# ---- Release identity ------------------------------------------------------------------------------------------------------
FDM_VERSION=0.1.0-rc1
# Recorded in the images and shown on the Operations page. Normally: FDM_BUILD_COMMIT=$(git rev-parse HEAD)
FDM_BUILD_COMMIT=unknown
FDM_BUILD_TIME=unknown

# ---- Public addresses (REQUIRED) -------------------------------------------------------------------------------------------
# The canonical external origin of the application: scheme://host[:port], no path. HTTPS in production.
APP_PUBLIC_ORIGIN=https://fdm.example.org
# The origin browsers and Workers use for presigned media URLs. In TLS mode this is a second port of the same host (nginx proxies
# it to MinIO). It must be https when APP_PUBLIC_ORIGIN is https.
PILOT_STORAGE_ORIGIN=https://fdm.example.org:9443
# Host part of PILOT_STORAGE_ORIGIN (the Worker container maps it to the Docker host).
PILOT_STORAGE_HOST=fdm.example.org

# ---- Edge nginx -----------------------------------------------------------------------------------------------------------
# tls      = nginx terminates HTTPS with secrets/tls/fullchain.pem + privkey.pem and redirects HTTP to APP_PUBLIC_ORIGIN (production).
# loopback = plain HTTP for evaluating the pilot on one machine at http://localhost:<port> only.
NGINX_MODE=tls
PILOT_HTTP_PORT=80
PILOT_HTTPS_PORT=443
PILOT_STORAGE_TLS_PORT=9443
# MinIO's S3 port, published on the loopback interface only.
PILOT_MINIO_PORT=9000

# ---- PostgreSQL (REQUIRED) -------------------------------------------------------------------------------------------------
POSTGRES_DB=fdm
POSTGRES_USER=fdm_app
POSTGRES_PASSWORD=REPLACE_WITH_A_LONG_RANDOM_PASSWORD

# ---- RabbitMQ (REQUIRED, optional transport) -------------------------------------------------------------------------------
RABBITMQ_USER=fdm
RABBITMQ_PASSWORD=REPLACE_WITH_A_LONG_RANDOM_PASSWORD
RABBITMQ_VHOST=/

# ---- Object storage (REQUIRED) ---------------------------------------------------------------------------------------------
# Root credentials are used only by MinIO itself and the one-shot minio-init job. The application uses the access key below,
# which minio-init creates with a policy limited to the bucket.
MINIO_ROOT_USER=fdm_minio_root
MINIO_ROOT_PASSWORD=REPLACE_WITH_A_LONG_RANDOM_PASSWORD
STORAGE_BUCKET=media-assets
STORAGE_ACCESS_KEY=fdm-application-key
STORAGE_SECRET_KEY=REPLACE_WITH_A_LONG_RANDOM_SECRET

# ---- First account (used only while the database has no users) -------------------------------------------------------------
# The password is read from secrets/owner_password; it is not an environment variable.
FDM_OWNER_EMAIL=owner@fdm.example.org
FDM_OWNER_NAME=Pilot Owner
FDM_WORKSPACE_NAME=Pilot Workspace
FDM_WORKSPACE_SLUG=pilot

# ---- Worker (REQUIRED) -----------------------------------------------------------------------------------------------------
# Any UUID you generate. The secret is read from secrets/worker_secret (at least 24 random characters).
FDM_WORKER_CREDENTIAL_ID=00000000-0000-4000-8000-000000000000
FDM_WORKER_CREDENTIAL_NAME=pilot-worker
FDM_WORKER_NAME=pilot-worker
WORKER_MAX_ACTIVE_JOBS=1

# ---- Optional: AI (Ollama runs outside this stack) -------------------------------------------------------------------------
# CONTENT_AI_PROVIDER=OLLAMA on the API and CONTENT_AI_RUNTIME=OLLAMA on the Worker enable LLM copy; leave the defaults to run
# deterministically and degrade safely when no Ollama is reachable.
CONTENT_AI_PROVIDER=DETERMINISTIC_TEST
CONTENT_AI_MODEL=deterministic-v1
CONTENT_AI_RUNTIME=
CONTENT_AI_ENDPOINT=http://host.docker.internal:11434
WORKER_CONTENT_AI_MODEL=llama3.2:3b
SEMANTIC_HIGHLIGHT_RUNTIME=

# ---- Optional: real publishing (disabled by default; TEST publishing needs none of this) -----------------------------------
SOCIAL_CREDENTIAL_ENCRYPTION_KEY=
INSTAGRAM_ENABLED=false
META_APP_ID=
META_APP_SECRET=
META_OAUTH_REDIRECT_URI=
META_PUBLIC_BASE_URL=
TIKTOK_ENABLED=false
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REDIRECT_URI=
WORKER_INSTAGRAM_PUBLISHING_ENABLED=false
