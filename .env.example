# Copy this file to .env and adjust as needed:
#   cp .env.example .env
#
# These are safe DEVELOPMENT-ONLY defaults. Never put real credentials in
# this file, and never commit a real .env file.

# ---- PostgreSQL ------------------------------------------------------------
POSTGRES_DB=media_platform
POSTGRES_USER=media_platform
POSTGRES_PASSWORD=dev_password_change_me

# ---- RabbitMQ ---------------------------------------------------------------
RABBITMQ_USER=media_platform
RABBITMQ_PASSWORD=dev_password_change_me
RABBITMQ_VHOST=/
# Host port for the RabbitMQ management UI (http://localhost:<port>).
RABBITMQ_MANAGEMENT_PORT=15672

# ---- Spring Boot API ---------------------------------------------------------
# dev = verbose logging, meant for local/Docker development only.
# prod is a placeholder for a future production deployment (see
# apps/api-spring/src/main/resources/application-prod.yml).
SPRING_PROFILES_ACTIVE=dev

# ---- Edge / reverse proxy -----------------------------------------------------
# The single local URL the app is served from: http://localhost:<port>
NGINX_PORT=8080
