# Copy this file to .env and adjust as needed:
#   cp .env.example .env
#
# These are safe DEVELOPMENT-ONLY defaults. Never put real credentials in
# this file, and never commit a real .env file.

# ---- PostgreSQL ------------------------------------------------------------
POSTGRES_DB=media_platform
POSTGRES_USER=media_platform
POSTGRES_PASSWORD=dev_password_change_me

# ---- RabbitMQ ---------------------------------------------------------------
RABBITMQ_USER=media_platform
RABBITMQ_PASSWORD=dev_password_change_me
RABBITMQ_VHOST=/
# Host port for the RabbitMQ management UI (http://localhost:<port>).
RABBITMQ_MANAGEMENT_PORT=15672

# ---- Object storage / MinIO -------------------------------------------------
MINIO_ROOT_USER=media_platform
MINIO_ROOT_PASSWORD=dev_minio_password_change_me
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
STORAGE_ENDPOINT=http://minio:9000
STORAGE_PUBLIC_ENDPOINT=http://localhost:9000
STORAGE_REGION=us-east-1
STORAGE_BUCKET=media-assets
STORAGE_ACCESS_KEY=media_platform
STORAGE_SECRET_KEY=dev_minio_password_change_me
STORAGE_PRESIGNED_UPLOAD_TTL=15m
STORAGE_PRESIGNED_DOWNLOAD_TTL=5m

# ---- Spring Boot API ---------------------------------------------------------
# dev = verbose logging, meant for local/Docker development only.
# prod is a placeholder for a future production deployment (see
# apps/api-spring/src/main/resources/application-prod.yml).
SPRING_PROFILES_ACTIVE=dev
SESSION_COOKIE_SECURE=false

# ---- Development bootstrap ---------------------------------------------------
# Used only by the dev profile. On first startup these values create an initial
# workspace, owner user, and optional second user for manual collaboration tests.
BOOTSTRAP_ADMIN_EMAIL=owner@example.com
BOOTSTRAP_ADMIN_PASSWORD=dev_owner_password_change_me
BOOTSTRAP_ADMIN_DISPLAY_NAME=Owner
BOOTSTRAP_WORKSPACE_NAME=FD Multimedia
BOOTSTRAP_WORKSPACE_SLUG=fd-multimedia

BOOTSTRAP_SECOND_USER_EMAIL=associate@example.com
BOOTSTRAP_SECOND_USER_PASSWORD=dev_admin_password_change_me
BOOTSTRAP_SECOND_USER_DISPLAY_NAME=Associate
BOOTSTRAP_SECOND_USER_ROLE=ADMIN

# Optional development worker credential. The worker agent authenticates with
# FDM_WORKER_TOKEN=<id>.<secret>; the API stores only a BCrypt hash.
BOOTSTRAP_WORKER_CREDENTIAL_ID=11111111-1111-4111-8111-111111111111
BOOTSTRAP_WORKER_CREDENTIAL_NAME=local-dev-worker
BOOTSTRAP_WORKER_CREDENTIAL_SECRET=dev_worker_secret_change_me
WORKER_HEARTBEAT_INTERVAL=10s
WORKER_OFFLINE_THRESHOLD=30s
WORKER_MAX_ACTIVE_JOBS=1

# ---- Development jobs ---------------------------------------------------------
JOB_LEASE_DURATION=30s
JOB_DEFAULT_MAX_ATTEMPTS=3
JOB_MAX_SYSTEM_TEST_DURATION_MS=10000
JOB_MAX_SYSTEM_TEST_MESSAGE_LENGTH=200
FDM_WORKER_JOB_POLL_SECONDS=3
SCHEDULING_POLICY_ID=TELEMETRY_AWARE_V1
SCHEDULING_DECISION_RETENTION_DAYS=30
SCHEDULING_DECISION_CLEANUP_CRON=0 17 3 * * *
SCHEDULING_CANDIDATE_LIMIT=25
SCHEDULING_TELEMETRY_FRESHNESS_WINDOW=60s
SCHEDULING_STARVATION_THRESHOLD=10m
SCHEDULING_HISTORY_WINDOW=7d
SCHEDULING_MIN_HISTORICAL_SAMPLES=3
SCHEDULING_CRITICAL_MEMORY_AVAILABLE_RATIO=0.05
SCHEDULING_HISTORY_REFERENCE_EXECUTION_MS=60000
FFPROBE_PATH=ffprobe
FFMPEG_PATH=ffmpeg
TRANSCRIPTION_RUNTIME=WHISPER_CLI
TRANSCRIPTION_COMMAND=whisper
TRANSCRIPTION_MODEL=base
TRANSCRIPTION_TIMEOUT_SECONDS=900
APP_TRANSCRIPTION_PROVIDER=LOCAL_WHISPER_CLI
APP_TRANSCRIPTION_MODEL=local
MEDIA_MAX_DOWNLOAD_SIZE_BYTES=524288000
MEDIA_CONNECT_TIMEOUT=10s
MEDIA_READ_TIMEOUT=30s
MEDIA_MAX_REDIRECTS=3

# ---- Edge / reverse proxy -----------------------------------------------------
# The single local URL the app is served from: http://localhost:<port>
NGINX_PORT=8080

# ---- Social publishing: credential encryption ---------------------------------
# Base64-encoded 32-byte (AES-256) key. Leave blank for TEST-only development —
# the app starts fine without it. Required only if INSTAGRAM_ENABLED=true, and
# validated at startup: generate your own with, e.g.
#   openssl rand -base64 32
# Never commit a real key. Losing this key makes every stored Instagram
# credential undecryptable, so back it up outside of source control.
SOCIAL_CREDENTIAL_ENCRYPTION_KEY=

# ---- Social publishing: Instagram (Meta) ---------------------------------------
# Disabled by default. TEST publishing works with none of this configured.
# See docs/ARCHITECTURE.md for the full Instagram integration writeup.
INSTAGRAM_ENABLED=false
# Meta App Dashboard > App ID / App Secret. Never commit real values.
META_APP_ID=
META_APP_SECRET=
# Must exactly match a "Valid OAuth Redirect URI" configured in the Meta App
# Dashboard, e.g. https://your-public-domain.example.com/api/social-accounts/instagram/callback
META_OAUTH_REDIRECT_URI=
# The same public origin, no path, e.g. https://your-public-domain.example.com
# Meta's servers fetch publish media from <this>/api/public-media/<token> —
# it must be a real, publicly reachable HTTPS origin in production. A local
# "http://localhost:..." value here cannot work for real publishing, since
# Meta's servers cannot reach your machine's localhost.
META_PUBLIC_BASE_URL=
META_GRAPH_API_VERSION=v25.0

# ---- Worker: Instagram publishing opt-in ---------------------------------------
# This worker never receives an Instagram access token even when enabled — all
# credential-bearing calls stay on the backend. This flag only lets an operator
# choose which physical workers are trusted to drive real external publishes.
WORKER_INSTAGRAM_PUBLISHING_ENABLED=false

# ---- Content publishing schedule (Phase 11B) -----------------------------------
# The central server (not a Worker) owns dispatch: it polls for due
# PublishSchedule rows and turns each one into a normal Publication at its
# scheduled instant. See docs/ARCHITECTURE.md for the full design.
PUBLISH_SCHEDULER_ENABLED=true
# How far in the future a schedule must be, to avoid "schedule for right now" races.
PUBLISH_SCHEDULE_MIN_LEAD_SECONDS=30
# Maximum how far in the future a schedule may be created.
PUBLISH_SCHEDULE_MAX_DAYS=365
# How many due schedules one dispatcher poll processes at most.
PUBLISH_SCHEDULE_DISPATCH_BATCH_SIZE=50
# Maximum span the calendar endpoint will return in one request.
PUBLISH_SCHEDULE_CALENDAR_MAX_DAYS=90
# Maximum rows returned by bounded history queries.
PUBLISH_SCHEDULE_HISTORY_MAX_RESULTS=100
# How often the server checks for due schedules.
PUBLISH_SCHEDULER_POLL_MS=15000
