# Copy this file to .env and adjust as needed:
#   cp .env.example .env
#
# These are safe DEVELOPMENT-ONLY defaults. Never put real credentials in
# this file, and never commit a real .env file.

# ---- PostgreSQL ------------------------------------------------------------
POSTGRES_DB=media_platform
POSTGRES_USER=media_platform
POSTGRES_PASSWORD=dev_password_change_me

# ---- RabbitMQ ---------------------------------------------------------------
RABBITMQ_USER=media_platform
RABBITMQ_PASSWORD=dev_password_change_me
RABBITMQ_VHOST=/
# Host port for the RabbitMQ management UI (http://localhost:<port>).
RABBITMQ_MANAGEMENT_PORT=15672

# ---- Object storage / MinIO -------------------------------------------------
MINIO_ROOT_USER=media_platform
MINIO_ROOT_PASSWORD=dev_minio_password_change_me
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
STORAGE_ENDPOINT=http://minio:9000
STORAGE_PUBLIC_ENDPOINT=http://localhost:9000
STORAGE_REGION=us-east-1
STORAGE_BUCKET=media-assets
STORAGE_ACCESS_KEY=media_platform
STORAGE_SECRET_KEY=dev_minio_password_change_me
STORAGE_PRESIGNED_UPLOAD_TTL=15m
STORAGE_PRESIGNED_DOWNLOAD_TTL=5m

# ---- Spring Boot API ---------------------------------------------------------
# dev = verbose logging, meant for local/Docker development only.
# prod is a placeholder for a future production deployment (see
# apps/api-spring/src/main/resources/application-prod.yml).
SPRING_PROFILES_ACTIVE=dev
SESSION_COOKIE_SECURE=false

# ---- Development bootstrap ---------------------------------------------------
# Used only by the dev profile. On first startup these values create an initial
# workspace, owner user, and optional second user for manual collaboration tests.
BOOTSTRAP_ADMIN_EMAIL=owner@example.com
BOOTSTRAP_ADMIN_PASSWORD=dev_owner_password_change_me
BOOTSTRAP_ADMIN_DISPLAY_NAME=Owner
BOOTSTRAP_WORKSPACE_NAME=FD Multimedia
BOOTSTRAP_WORKSPACE_SLUG=fd-multimedia

BOOTSTRAP_SECOND_USER_EMAIL=associate@example.com
BOOTSTRAP_SECOND_USER_PASSWORD=dev_admin_password_change_me
BOOTSTRAP_SECOND_USER_DISPLAY_NAME=Associate
BOOTSTRAP_SECOND_USER_ROLE=ADMIN

# Optional development worker credential. The worker agent authenticates with
# FDM_WORKER_TOKEN=<id>.<secret>; the API stores only a BCrypt hash.
BOOTSTRAP_WORKER_CREDENTIAL_ID=11111111-1111-4111-8111-111111111111
BOOTSTRAP_WORKER_CREDENTIAL_NAME=local-dev-worker
BOOTSTRAP_WORKER_CREDENTIAL_SECRET=dev_worker_secret_change_me
WORKER_HEARTBEAT_INTERVAL=10s
WORKER_OFFLINE_THRESHOLD=30s
WORKER_MAX_ACTIVE_JOBS=1

# ---- Development jobs ---------------------------------------------------------
JOB_LEASE_DURATION=30s
JOB_DEFAULT_MAX_ATTEMPTS=3
JOB_MAX_SYSTEM_TEST_DURATION_MS=10000
JOB_MAX_SYSTEM_TEST_MESSAGE_LENGTH=200
FDM_WORKER_JOB_POLL_SECONDS=3
SCHEDULING_POLICY_ID=TELEMETRY_AWARE_V1
SCHEDULING_DECISION_RETENTION_DAYS=30
SCHEDULING_DECISION_CLEANUP_CRON=0 17 3 * * *
SCHEDULING_CANDIDATE_LIMIT=25
SCHEDULING_TELEMETRY_FRESHNESS_WINDOW=60s
SCHEDULING_STARVATION_THRESHOLD=10m
SCHEDULING_HISTORY_WINDOW=7d
SCHEDULING_MIN_HISTORICAL_SAMPLES=3
SCHEDULING_CRITICAL_MEMORY_AVAILABLE_RATIO=0.05
SCHEDULING_HISTORY_REFERENCE_EXECUTION_MS=60000
FFPROBE_PATH=ffprobe
FFMPEG_PATH=ffmpeg
TRANSCRIPTION_RUNTIME=WHISPER_CLI
TRANSCRIPTION_COMMAND=whisper
TRANSCRIPTION_MODEL=base
TRANSCRIPTION_TIMEOUT_SECONDS=900
APP_TRANSCRIPTION_PROVIDER=LOCAL_WHISPER_CLI
APP_TRANSCRIPTION_MODEL=local
MEDIA_MAX_DOWNLOAD_SIZE_BYTES=524288000
MEDIA_CONNECT_TIMEOUT=10s
MEDIA_READ_TIMEOUT=30s
MEDIA_MAX_REDIRECTS=3

# ---- Edge / reverse proxy -----------------------------------------------------
# The single local URL the app is served from: http://localhost:<port>
NGINX_PORT=8080
