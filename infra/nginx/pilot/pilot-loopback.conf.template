# Pilot edge, loopback evaluation mode: plain HTTP on localhost only (browsers treat http://localhost as a secure context and accept
# Secure cookies there). This is for evaluating a pilot on one machine; a real deployment uses pilot-tls.conf.template.
limit_req_zone $binary_remote_addr zone=fdm_login:10m rate=10r/m;

server {
    listen 8080;
    server_name _;
    include /etc/nginx/conf.d/locations.inc;
}
