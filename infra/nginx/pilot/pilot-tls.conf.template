# Pilot edge, TLS mode (the supported production model): nginx terminates HTTPS with the certificate in /etc/nginx/tls and owns the
# HTTP to HTTPS redirect. Nothing upstream redirects, so no redirect loop is possible.
limit_req_zone $binary_remote_addr zone=fdm_login:10m rate=10r/m;

# Plain HTTP: redirect to the canonical origin (not to a Host header the client chose); keep the internal health probe reachable.
server {
    listen 8080;
    server_name _;
    server_tokens off;
    resolver 127.0.0.11 valid=5s ipv6=off;

    location = /api/actuator/health/readiness {
        set $fdm_api http://api:8080;
        include /etc/nginx/pilot/proxy-params.inc;
        proxy_pass $fdm_api;
    }
    location / {
        return 301 ${APP_PUBLIC_ORIGIN}$request_uri;
    }
}

server {
    listen 8443 ssl;
    http2 on;
    server_name _;

    ssl_certificate     /etc/nginx/tls/fullchain.pem;
    ssl_certificate_key /etc/nginx/tls/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;
    ssl_session_cache shared:fdm_tls:10m;
    ssl_session_timeout 1h;
    ssl_session_tickets off;

    add_header Strict-Transport-Security "max-age=31536000" always;
    include /etc/nginx/conf.d/locations.inc;
}

# Object storage for presigned URLs, on its own origin so MinIO's SigV4 host check sees the public host. Media streams through
# without buffering; the body limit equals MEDIA_MAX_DOWNLOAD_SIZE_BYTES (500 MiB) plus headroom.
server {
    listen 9443 ssl;
    http2 on;
    server_name _;
    server_tokens off;

    ssl_certificate     /etc/nginx/tls/fullchain.pem;
    ssl_certificate_key /etc/nginx/tls/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_tickets off;
    add_header Strict-Transport-Security "max-age=31536000" always;
    add_header X-Content-Type-Options "nosniff" always;

    resolver 127.0.0.11 valid=5s ipv6=off;
    client_max_body_size 520m;
    proxy_request_buffering off;
    proxy_buffering off;
    location / {
        set $fdm_minio http://minio:9000;
        proxy_http_version 1.1;
        proxy_set_header Host $http_host;
        proxy_set_header Connection "";
        proxy_connect_timeout 3s;
        proxy_read_timeout 600s;
        proxy_send_timeout 600s;
        proxy_pass $fdm_minio;
    }
}
