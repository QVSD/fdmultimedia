# Included inside every pilot server block that serves the application (envsubst fills the ${...} variables at container start).
server_tokens off;

# Security headers. HSTS is added only by the TLS server block.
add_header X-Content-Type-Options "nosniff" always;
add_header X-Frame-Options "DENY" always;
add_header Referrer-Policy "strict-origin-when-cross-origin" always;
add_header Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()" always;
# Angular's production build emits no inline script; component styles are injected at runtime, hence style-src 'unsafe-inline'.
# Presigned media is loaded from the storage origin only.
add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: ${PILOT_STORAGE_ORIGIN}; media-src 'self' blob: ${PILOT_STORAGE_ORIGIN}; connect-src 'self' ${PILOT_STORAGE_ORIGIN}; font-src 'self' data:; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'" always;

# Re-resolve container names (replicas and restarts change addresses); nginx round-robins every returned address.
resolver 127.0.0.11 valid=5s ipv6=off;

# Login is the one unauthenticated state-changing endpoint: a small per-address budget (10/min, burst 5) answered with 429.
location = /api/auth/login {
    limit_req zone=fdm_login burst=5 nodelay;
    limit_req_status 429;
    client_max_body_size 8k;
    set $fdm_api http://api:8080;
    include /etc/nginx/pilot/proxy-params.inc;
    proxy_connect_timeout 3s;
    proxy_read_timeout 30s;
    proxy_hide_header X-Content-Type-Options;
    proxy_hide_header X-Frame-Options;
    proxy_pass $fdm_api;
}

location /api/ {
    # JSON API: bodies are small. Media moves through object storage, never through this proxy.
    client_max_body_size 2m;
    set $fdm_api http://api:8080;
    include /etc/nginx/pilot/proxy-params.inc;
    proxy_connect_timeout 3s;
    proxy_send_timeout 60s;
    proxy_read_timeout 60s;
    # Only idempotent methods are retried on another replica; never enable non_idempotent here.
    proxy_next_upstream error timeout http_502 http_503 http_504;
    proxy_next_upstream_tries 4;
    proxy_hide_header X-Content-Type-Options;
    proxy_hide_header X-Frame-Options;
    proxy_pass $fdm_api;
}

location / {
    client_max_body_size 1k;
    set $fdm_web http://web:8080;
    include /etc/nginx/pilot/proxy-params.inc;
    proxy_pass $fdm_web;
}
